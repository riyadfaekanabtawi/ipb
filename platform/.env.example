# Neon pooled connection string (Project → Connection details → Pooled)
DATABASE_URL=postgres://user:password@ep-xxxx-pooler.us-east-1.aws.neon.tech/trama?sslmode=require
# 32 random bytes, base64:  openssl rand -base64 32   (wraps every company data key — back it up)
MASTER_KEY=
# At least 32 chars:  openssl rand -base64 48
JWT_SECRET=
APP_URL=https://trama-app.vercel.app
# Optional: send invites/resets via Gmail SMTP (same app password as contact-api)
GMAIL_USER=
GMAIL_APP_PASSWORD=
