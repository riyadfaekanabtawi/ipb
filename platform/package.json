{
  "name": "trama-platform",
  "private": true,
  "type": "module",
  "description": "Trama platform: licensing, auth and encrypted sync API (plus the web app and admin portal).",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "test": "vitest run",
    "migrate": "tsx scripts/migrate.ts",
    "create-admin": "tsx scripts/create-admin.ts",
    "dev:api": "tsx scripts/dev-server.ts",
    "build": "vite build && node scripts/merge-landing.mjs",
    "dev:web": "vite",
    "preview": "vite preview"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "hono": "^4.13.14",
    "jose": "^6.2.13",
    "nodemailer": "^10.2.1",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
