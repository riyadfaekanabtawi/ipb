    "Se borrarán los datos locales de este iPad y se descargarán los de tu empresa. Exporta un respaldo antes si lo necesitas." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The local data on this iPad will be erased and your company's data downloaded. Export a backup first if you need it."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os dados locais deste iPad serão apagados e os da sua empresa serão baixados. Exporte um backup antes, se precisar."
          }
        }
      }
    },
