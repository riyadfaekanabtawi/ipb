            "value" : "Records are added or updated; nothing on this iPad is deleted. Imported users stay inactive until you give them a password."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os registros são adicionados ou atualizados; nada local é apagado. Os usuários importados ficam inativos até receberem uma senha."
          }
        }
      }
    },
    "Se borraron todos los datos" : {
